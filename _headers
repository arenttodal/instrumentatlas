# Cloudflare Pages headers

# Big binaries never change once deployed, so cache them hard. Their content is
# fixed for the life of a file name: re-cutting a clip or re-exporting a model
# means a new name, not a new version of an old one.
#
# The .glb files live FLAT in /viewer/, not in /viewer/models/, so the old
# /viewer/models/* rule matched nothing and every visitor re-downloaded roughly
# 17 MB of models on each visit. /viewer/vendor/* is gone entirely: three.js now
# comes from unpkg and is cached by that CDN rather than by us.
/viewer/*.glb
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Studio renders and per-instrument demo clips.
/audio/*
  Cache-Control: public, max-age=31536000, immutable

# The score viewer keeps its stems under its own folder, so the rule above
# never matched them: 78 MB of course track and 33 MB of Valley Sunrise came
# down from the origin on every single visit. Same rule as the others, and the
# same condition — re-bouncing a stem means giving it a new name.
/valley-sunrise-app/audio/*
  Cache-Control: public, max-age=31536000, immutable

# Converted engravings. Rebuilding one from plates-source/ keeps the file name,
# so bump the name if a plate is ever re-cut after going live.
/plates/*
  Cache-Control: public, max-age=31536000, immutable

# Family hover footage. Only fetched on hover, but fetched once.
/video/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should revalidate so edits go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Allow the pages to be framed by your Webflow site (and only your site).
/*
  Content-Security-Policy: frame-ancestors 'self' https://*.webflow.io https://evenant.com https://*.evenant.com
