# Cloudflare Pages headers

# Models and the vendored three.js never change once deployed — cache hard.
/viewer/models/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/viewer/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# HTML should revalidate so edits go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

# Allow the pages to be framed by your Webflow site (and only your site).
/*
  Content-Security-Policy: frame-ancestors 'self' https://*.webflow.io https://evenant.com https://*.evenant.com
