48.0, 0.5, 86], [248.0, 0.5, 93], [248.5, 0.5, 90], [249.0, 0.5, 83], [249.0, 0.5, 92], [249.5, 0.5, 88], [250.0, 0.5, 86], [250.0, 0.5, 93], [250.5, 0.5, 86], [250.5, 0.5, 90], [251.0, 0.5, 83], [251.0, 0.5, 92], [251.5, 0.5, 88], [252.0, 0.5, 86], [252.0, 0.5, 93], [252.5, 0.5, 86], [252.5, 0.5, 90], [253.0, 0.5, 83], [253.0, 0.5, 92], [253.5, 0.5, 88], [254.0, 0.5, 86], [254.0, 0.5, 93], [254.5, 0.5, 86], [254.5, 0.5, 90], [255.0, 0.5, 83], [255.0, 0.5, 92], [255.308, 6.344, 38], [255.5, 0.5, 88], [255.76, 6.765, 33], [256.0, 0.5, 86], [256.0, 0.5, 93], [256.5, 0.5, 90], [257.0, 0.5, 83], [257.0, 0.5, 92], [257.5, 0.5, 88], [257.807, 4.128, 62], [258.0, 0.5, 86], [258.0, 0.5, 93], [258.5, 0.5, 86], [258.5, 0.5, 90], [259.0, 0.5, 83], [259.0, 0.5, 92], [259.5, 0.5, 88], [260.0, 5.0, 38]], "sources": ["Timpani", "Glockenspiel", "Xylophone", "Snare", "Cymbal", "BIG ROLL", "Piano"], "file": "perc"}], "title": "Valley Sunrise", "composer": "Arn Andersson", "note": "Written for Audio Imperia Nucleus. D minor to D Lydian in two minutes.", "audioBase": "audio/scores/valley-sunrise/", "tips": [{"id": "open", "bar": 1, "beats": 36, "tracks": ["strings", "flute", "choir"], "title": "D minor, and almost nothing", "body": "The piece opens on an atmosphere and a string bed \u2014 one or two lanes, no rhythm, no bass. Everything that follows is measured against how little is happening here."}, {"id": "oboe", "bar": 10, "beats": 24, "tracks": ["reeds"], "title": "The oboe takes the theme", "body": "The first real melody arrives on solo oboe over the atmosphere. Reedy and exposed \u2014 it carries over a texture without needing volume, which is what the oboe is for.", "action": {"solo": ["reeds", "strings"]}}, {"id": "lowstrings", "bar": 11, "beats": 20, "tracks": ["cello", "bass", "horn"], "title": "The bottom arrives", "body": "Cello, double bass and horns enter within a bar of each other. The harmony has been floating; this is the moment it gets a floor."}, {"id": "violins", "bar": 27, "beats": 24, "tracks": ["violin-1", "violin-2"], "title": "Violins, held back until now", "body": "Twenty-six bars in before the violins play a note. Withholding the most obvious melodic voice is what makes its entry land \u2014 and it arrives already in the middle of a build."}, {"id": "wave1", "bar": 30, "beats": 12, "tracks": [], "title": "First wave \u2014 ten lanes at once", "body": "Ten of the twelve lanes are playing. In a two-minute cue this would be a reasonable place to finish. It is not the climax; it is the first tease."}, {"id": "pullback", "bar": 33, "beats": 20, "tracks": [], "title": "Then take it all away", "body": "Straight from the peak down to three lanes. Arn builds in waves rather than one long ramp \u2014 tease, pull back, tease again \u2014 so the listener is never quite sure how big it can get."}, {"id": "silence", "bar": 37, "beats": 4, "tracks": [], "title": "One bar of nothing", "body": "Bar 37 is empty. After a full-orchestra peak four bars earlier, a single silent bar resets the ear completely \u2014 and it costs nothing to write."}, {"id": "rebuild", "bar": 50, "beats": 32, "tracks": [], "title": "The second build, and it is steeper", "body": "From four lanes to ten in six bars. The first wave took sixteen bars to build; this one takes six, which is why it reads as urgent rather than repetitive."}, {"id": "finale", "bar": 58, "beats": 32, "tracks": [], "title": "Full orchestra, and a different mode", "body": "Eleven lanes, the densest bars in the piece, and the trumpets finally doing real work. But the lift is not only size \u2014 the piece has arrived back on D and turned Lydian. Same tonic as bar 1, opposite feeling.", "action": {"solo": []}}, {"id": "lydian", "bar": 63, "beats": 12, "tracks": ["violin-1", "flute", "choir"], "title": "Why Lydian and not major", "body": "The raised fourth makes it brighter and more open than major \u2014 and it is idiomatic in Norwegian folk music, which is where Arn takes the colour from. Starting minor and ending Lydian on the same tonic reads as coming home changed rather than merely resolved."}]}